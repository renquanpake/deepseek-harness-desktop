{
  "name": "deepseek-harness-desktop",
  "productName": "DeepSeek Harness",
  "version": "0.3.5",
  "description": "DeepSeek Harness 桌面端外壳 - 原生 Windows 一体化装甲",
  "author": "renquanpake",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration.test.js",
    "runtime:prepare": "node prepare-runtime.js",
    "runtime:python": "node scripts/prepare-python-runtime.js",
    "clean:legacy": "node scripts/clean-legacy.js",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings 0",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='lib/**' --test-coverage-include='src/**' --test-coverage-include='main.js' --test-coverage-lines=75 --test-coverage-branches=70 --test-coverage-functions=62 test/*.test.js",
    "check:upstream": "node scripts/check-upstream-contract.js"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "electron": "^37.10.3",
    "eslint": "^9.39.5",
    "globals": "^16.5.0"
  }
}
