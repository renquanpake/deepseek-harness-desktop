{
  "name": "deepseek-harness-desktop",
  "productName": "DeepSeek Harness",
  "version": "0.2.0",
  "description": "DeepSeek Harness 桌面端外壳 - 原生 Windows 一体化装甲",
  "author": "renquanpake",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js test/preset-hydrator.test.js test/self-repair.test.js",
    "test:integration": "node --test test/integration.test.js",
    "runtime:prepare": "node prepare-runtime.js",
    "clean:legacy": "node scripts/clean-legacy.js",
    "dist": "npm run runtime:prepare && electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "electron": "^37.10.3",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.renquanpake.deepseek-harness-desktop",
    "productName": "DeepSeek Harness",
    "asar": true,
    "asarUnpack": [
      "dsh-runtime/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "lib/",
      "package.json",
      "build/",
      "dsh-runtime/"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": null,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeepSeek Harness"
    }
  }
}
